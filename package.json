{
  "name": "@qamposer/react",
  "version": "0.1.0",
  "description": "React components for quantum circuit composition",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./visualization": {
      "import": {
        "types": "./dist/visualization.d.ts",
        "default": "./dist/visualization.js"
      },
      "require": {
        "types": "./dist/visualization.d.cts",
        "default": "./dist/visualization.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "link:yalc": "pnpm build && yalc publish",
    "push:yalc": "pnpm build && yalc push"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "plotly.js-basic-dist-min": "^2.35.0 || ^3.0.0",
    "react-plotly.js": "^2.6.0"
  },
  "peerDependenciesMeta": {
    "plotly.js-basic-dist-min": {
      "optional": true
    },
    "react-plotly.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-plotly.js": "^2.6.3",
    "esbuild-sass-plugin": "^3.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.97.1",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "quantum",
    "circuit",
    "qiskit",
    "react",
    "editor",
    "qasm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/QAMP-62/qamposer-react"
  }
}
