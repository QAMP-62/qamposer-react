{
  "name": "@qamposer/react",
  "version": "0.1.0",
  "description": "React components for quantum circuit composition",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./visualization": {
      "import": {
        "types": "./dist/visualization.d.ts",
        "default": "./dist/visualization.js"
      },
      "require": {
        "types": "./dist/visualization.d.cts",
        "default": "./dist/visualization.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "size": "size-limit",
    "prepublishOnly": "pnpm build",
    "link:yalc": "pnpm build && yalc publish",
    "push:yalc": "pnpm build && yalc push"
  },
  "peerDependencies": {
    "plotly.js-basic-dist-min": "^2.35.0 || ^3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-plotly.js": "^2.6.0"
  },
  "peerDependenciesMeta": {
    "plotly.js-basic-dist-min": {
      "optional": true
    },
    "react-plotly.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@size-limit/file": "^12.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-plotly.js": "^2.6.3",
    "esbuild-sass-plugin": "^3.3.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^20.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.97.1",
    "size-limit": "^12.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "quantum",
    "circuit",
    "qiskit",
    "react",
    "editor",
    "qasm"
  ],
  "size-limit": [
    {
      "name": "index (QamposerMicro)",
      "path": "dist/index.js",
      "limit": "120 kB"
    },
    {
      "name": "visualization (Qamposer)",
      "path": "dist/visualization.js",
      "limit": "130 kB"
    }
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/QAMP-62/qamposer-react"
  }
}
